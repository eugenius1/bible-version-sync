{
  "name": "bible-version-sync",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bvs/web",
    "build": "npm run build -w @bvs/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run gen -w @bvs/core && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "^1.89.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
