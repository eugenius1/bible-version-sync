# Your YouVersion Platform app key (https://platform.youversion.com).
# It's a public client id, not a secret, but keep your real value in .env.local.
VITE_YV_APP_KEY=

# PostHog project token for usage data, errors and feedback (docs/analytics.md).
# Public, like the app key. Leave it empty and nothing is sent.
VITE_POSTHOG_KEY=
