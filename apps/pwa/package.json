{
  "name": "@bvs/pwa",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/__tests__/**' --coverage.exclude='src/data.generated.ts' --coverage.reporter=lcov --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@bvs/core": "*",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
